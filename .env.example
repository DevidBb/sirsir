# Пример переменных окружения JARVIS. Скопируйте в .env и заполните только нужное.
# Файл .env не попадает в git. Секреты никогда не пишутся в журнал и в память помощника.

# Claude через Agent SDK: нужен ЛИБО вход в Claude Code (`claude login`), ЛИБО ключ API.
# ANTHROPIC_API_KEY=

# Gemini (провайдер «gemini»): бесплатный ключ — https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Ollama Cloud: ключ — https://ollama.com/settings/keys
# OLLAMA_API_KEY=

# Где лежит Chromium для Playwright (по умолчанию — кэш Playwright или ./.playwright).
# PLAYWRIGHT_BROWSERS_PATH=

# Токены для внешних MCP-серверов ([mcp.servers.*] → env_vars в config.toml), например:
# GITHUB_PERSONAL_ACCESS_TOKEN=
